---
import { Image } from 'astro:assets';
import logo from '../assets/farm/logo.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="topbar">
	<div class="container topbar-inner">
		<a href="/" class="brand">
			<Image src={logo} alt="Farm Project logo" width={40} height={40} class="logo" />
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<nav aria-label="Main navigation">
			<HeaderLink href="/dashboard">Dashboard</HeaderLink>
			<HeaderLink href="/reports">Reports</HeaderLink>
			<HeaderLink href="/blog">Updates</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/coming-soon" class="btn-login">System Login</a>
		</nav>
	</div>
</header>
<style>
	.topbar {
		border-bottom: 1px solid var(--line);
		background: rgba(16, 26, 46, 0.85);
		backdrop-filter: blur(12px);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 0;
	}
	.brand {
		display: flex;
		gap: 12px;
		align-items: center;
		color: var(--text);
		font-weight: 700;
		font-size: 18px;
	}
	.brand:hover {
		text-decoration: none;
	}
	.brand :global(.logo) {
		border-radius: 12px;
		border: 1px solid var(--line);
		object-fit: cover;
	}
	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 18px;
		font-size: 14px;
	}
	nav :global(a:not(.btn-login)) {
		color: var(--text);
	}
	nav :global(a.active),
	nav :global(a:not(.btn-login):hover) {
		color: var(--brand);
		text-decoration: none;
	}
	.btn-login {
		background: linear-gradient(135deg, var(--brand), var(--brand-hover));
		color: #05070a;
		padding: 8px 18px;
		border-radius: 99px;
		font-weight: 700;
		font-size: 13px;
		text-transform: uppercase;
	}
	.btn-login:hover {
		text-decoration: none;
		filter: brightness(1.1);
	}
	@media (max-width: 900px) {
		.topbar-inner {
			flex-direction: column;
		}
		nav {
			justify-content: center;
		}
	}
</style>
