---
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import FarmLayout from './FarmLayout.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
const authorEntry = author ? await getEntry('authors', author) : undefined;
---

<FarmLayout title={`${title} | ${SITE_TITLE}`} description={description}>
	<article class="post">
		{
			heroImage && (
				<Image class="hero" width={1020} height={510} src={heroImage} alt="" />
			)
		}
		<header class="post-header">
			<p class="meta">
				<FormattedDate date={pubDate} />
				{authorEntry && <span> · {authorEntry.data.name}</span>}
			</p>
			<h1>{title}</h1>
			{
				updatedDate && (
					<p class="meta">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>
		<div class="prose">
			<slot />
		</div>
		{
			authorEntry && (
				<aside class="card card-pad author" aria-label="About the author">
					<strong>{authorEntry.data.name}</strong>
					<p class="muted small m-0">{authorEntry.data.bio}</p>
				</aside>
			)
		}
		<p><a href="/blog">← All updates</a></p>
	</article>
</FarmLayout>

<style>
	.post {
		max-width: 720px;
		margin: 0 auto;
	}
	.hero {
		width: 100%;
		height: auto;
		border-radius: 16px;
	}
	.post-header {
		text-align: center;
		padding: 16px 0 8px;
		border-bottom: 1px solid var(--line);
		margin-bottom: 24px;
	}
	.post-header h1 {
		margin: 8px 0;
	}
	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 14px;
	}
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 14px;
		display: block;
		overflow-x: auto;
	}
	.prose :global(th),
	.prose :global(td) {
		padding: 8px 10px;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}
	.prose :global(th) {
		color: var(--brand);
	}
	.author {
		margin: 32px 0 16px;
	}
</style>
