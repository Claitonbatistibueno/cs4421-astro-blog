---
import FarmLayout from '../../layouts/FarmLayout.astro';
import ReportNav from '../../components/reports/ReportNav.astro';
import Stats from '../../components/reports/Stats.astro';
import BarChart from '../../components/reports/BarChart.astro';
import { loadFarmDb } from '../../lib/farmDb';
import { TARGET_MARKET_WEIGHT, weightReport } from '../../lib/farmReports';
import { formatNumber } from '../../utils/format';

const r = weightReport(loadFarmDb());
const perfClass = (p: string) => (p === 'High' ? 'ok' : p === 'Good' ? 'warn' : 'bad');
---

<FarmLayout title="Performance Analytics | Farm Project">
	<h1>Performance Analytics</h1>
	<ReportNav />
	<Stats
		items={[
			{ value: formatNumber(r.stats.count), label: 'Animals weighed' },
			{ value: `${formatNumber(r.stats.avgWeight, 1)} kg`, label: 'Average current weight' },
			{ value: `${formatNumber(r.stats.avgAdg, 2)} kg/day`, label: 'Average daily gain (ADG)' },
			{ value: formatNumber(r.stats.readyMarket), label: `Ready for market (≥ ${TARGET_MARKET_WEIGHT} kg)` },
		]}
	/>
	<div class="grid-2">
		<BarChart title="Weight distribution" data={r.distribution} />
		<BarChart title="Performance (ADG: Low < 0.8 · Good < 1.2 · High)" data={r.performance} />
	</div>
	<h2>Individual performance &amp; projection</h2>
	<div class="table-scroll">
		<table class="data-table">
			<thead>
				<tr>
					<th>Tag</th><th>Breed / Lot</th><th>Last weighing</th><th class="num">Weight (kg)</th>
					<th class="num">ADG</th><th>Est. finish</th><th>Performance</th>
				</tr>
			</thead>
			<tbody>
				{
					r.herd.map((h) => (
						<tr>
							<td>{h.tag}</td>
							<td>{h.breed} {h.lot && <span class="muted">· {h.lot}</span>}</td>
							<td>{h.lastWeighing}</td>
							<td class="num">{formatNumber(h.weight, 1)}</td>
							<td class="num">{formatNumber(h.adg, 2)}</td>
							<td>{h.finish}{h.daysLeft > 0 && <span class="muted"> ({h.daysLeft} days)</span>}</td>
							<td><span class:list={['badge', perfClass(h.performance)]}>{h.performance}</span></td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</FarmLayout>
