---
import FarmLayout from '../layouts/FarmLayout.astro';
---

<FarmLayout title="Coming soon | Farm Project">
	<div class="card">
		<div class="card-pad">
			<span class="kicker">Coming soon</span>
			<h1>The Farm Project system is not online yet</h1>
			<p class="muted">
				This website is a static site served from Amazon S3 and CloudFront, which can only deliver
				HTML, CSS and images. The management system (login, dashboard and reports) is written in PHP
				with a MySQL database, so it needs a running server. It will go live in the containerised
				version of the project.
			</p>
			<p><a class="btn primary" href="/">Back to the home page</a></p>
		</div>
	</div>
</FarmLayout>
