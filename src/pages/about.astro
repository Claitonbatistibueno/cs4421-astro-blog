---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FarmLayout from '../layouts/FarmLayout.astro';
import aerialImg from '../assets/farm/pasture-aerial.webp';

const author = await getEntry('authors', 'claiton');
---

<FarmLayout
	title="About | Farm Project"
	description="What Farm Project is, how it is built and delivered, and who built it."
>
	<h1>About Farm Project</h1>

	<div class="intro">
		<div>
			<p>
				Farm Project is a management system for small and medium beef farms in Ireland. It tracks
				each animal instead of the herd average: weight gain, feeding cost, health treatments and
				the money that comes in and goes out.
			</p>
			<p>
				The goal is simple. A farmer should be able to see which animals are paying for themselves
				and which ones are not, without software made for large dairy operations.
			</p>
			<p><a href="/blog/why-i-built-farm-project/">Read why I built it →</a></p>
		</div>
		<Image class="intro-img" src={aerialImg} alt="Aerial view of cattle grazing in a field" />
	</div>

	<section>
		<div class="section-title"><h2>How it is built</h2></div>
		<div class="grid-2">
			<div class="card card-pad">
				<h3>The farm system</h3>
				<p class="muted small">
					PHP and MySQL for animals, lots, weighing, feeding, health and finance. A Python
					assistant helps with health checks. It runs locally with Docker Compose.
				</p>
			</div>
			<div class="card card-pad">
				<h3>This website</h3>
				<p class="muted small">
					Astro. The dashboard and reports read the same farm data, so the numbers match the
					original system.
				</p>
			</div>
		</div>
	</section>

	<section>
		<div class="section-title"><h2>How it is delivered</h2></div>
		<div class="table-scroll" tabindex="0" role="region" aria-label="How it is delivered (scrollable table)">
			<table class="data-table">
				<thead>
					<tr><th>Branch</th><th>What it builds</th><th>Where it runs</th></tr>
				</thead>
				<tbody>
					<tr>
						<td><code>main</code></td>
						<td>Static site</td>
						<td>Amazon S3 + CloudFront</td>
					</tr>
					<tr>
						<td><code>feat/server-side-rendering</code></td>
						<td>Node.js server in a container</td>
						<td>Amazon ECR + ECS Fargate</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="muted small">
			Every change goes through a pull request, the CI quality gate (lint, type check, tests,
			build) and an automated deploy written as infrastructure as code with AWS CDK.
		</p>
	</section>

	{
		author && (
			<section>
				<div class="section-title"><h2>Author</h2></div>
				<div class="card card-pad">
					<strong>{author.data.name}</strong>
					<p class="muted small m-0">{author.data.bio}</p>
				</div>
			</section>
		)
	}
</FarmLayout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 24px;
		align-items: start;
	}
	.intro :global(.intro-img) {
		width: 100%;
		height: auto;
		border-radius: 16px;
		border: 1px solid var(--line);
	}
	h3 {
		margin: 0 0 8px;
		font-size: 17px;
	}
	@media (max-width: 900px) {
		.intro {
			grid-template-columns: 1fr;
		}
	}
</style>
