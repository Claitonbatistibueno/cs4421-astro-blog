---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import FarmLayout from '../../layouts/FarmLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<FarmLayout
	title="Farm Updates | Farm Project"
	description="Project updates: the farm problem, sprint reviews and DevOps lessons."
>
	<h1>Farm Updates</h1>
	<p class="muted">Why the project exists, what each sprint delivered, and what I learned on the way.</p>
	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<a class="card card-pad post-card" href={`/blog/${post.id}/`}>
						<span class="small muted">
							<FormattedDate date={post.data.pubDate} />
						</span>
						<h2>{post.data.title}</h2>
						<p class="muted small m-0">{post.data.description}</p>
					</a>
				</li>
			))
		}
	</ul>
	<p class="small muted">
		<a href="/rss.xml">RSS feed</a>
	</p>
</FarmLayout>

<style>
	.posts {
		list-style: none;
		margin: 24px 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 16px;
	}
	.post-card {
		display: block;
		height: 100%;
		color: var(--text);
		transition: transform 0.2s, border-color 0.2s;
	}
	.post-card:hover,
	.post-card:focus-visible {
		text-decoration: none;
		transform: translateY(-3px);
		border-color: var(--brand);
	}
	.post-card h2 {
		margin: 6px 0 8px;
		font-size: 19px;
		color: #fff;
	}
</style>
